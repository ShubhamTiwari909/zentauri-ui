APP_NAME="Zentauri Backend"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local: mongodb://localhost:27017 (see README: docker compose up -d)
# Atlas: paste the full SRV string from Atlas → Connect → Drivers (replace <password>)
# URL-encode special characters in the password (@ → %40, etc.)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=zentauri_backend
MONGODB_FORMS_COLLECTION=form_submissions

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
ALLOWED_HOSTS=["localhost","127.0.0.1","zentauri-contact-form.vercel.app"]
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_FORM_CREATE=10/minute
