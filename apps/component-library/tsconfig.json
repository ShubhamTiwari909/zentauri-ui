{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@zentauri-ui/zentauri-components/design-system/tokens": [
        "../../packages/components/src/design-system/tokens"
      ],
      "@zentauri-ui/zentauri-components/ui/*/animated": [
        "../../packages/components/src/ui/*/animated"
      ],
      "@zentauri-ui/zentauri-components/ui/*": [
        "../../packages/components/src/ui/*"
      ],
      "@zentauri-ui/zentauri-components/charts/*": [
        "../../packages/components/src/charts/*"
      ],
      "@zentauri-ui/zentauri-components/hooks/*": [
        "../../packages/components/src/hooks/*"
      ],
      "@zentauri-ui/zentauri-components/hooks/utils": [
        "../../packages/components/src/lib/utils"
      ],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "content/**/*.json",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
