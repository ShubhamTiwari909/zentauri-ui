{
  "name": "zentauri-ui",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,md,mdx,yml,yaml,css,scss}\"",
    "format:changed": "node scripts/check-changed-format.mjs",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install",
    "release": "pnpm build && npm login && changeset publish",
    "check:tokens": "pnpm --filter @zentauri-ui/zentauri-components check:tokens",
    "update:test-health": "pnpm --filter @zentauri-ui/zentauri-components update:test-health",
    "test:docs": "pnpm --filter component-library test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.5",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "human-id": "4.1.1",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
