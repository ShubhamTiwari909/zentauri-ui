{
  "name": "@zentauri-ui/zentauri-components",
  "version": "2.1.1",
  "description": "React + Tailwind UI kit with charts, ESM/CJS builds, per-entry exports, and a zentauri-components / zentauri-ui CLI to vendor UI or hook source into your app",
  "keywords": [
    "react",
    "tailwindcss",
    "tailwind",
    "component-library",
    "ui-kit",
    "design-system",
    "typescript",
    "nextjs",
    "charts",
    "hooks",
    "animations"
  ],
  "homepage": "https://zentauri-ui.vercel.app/",
  "bugs": {
    "url": "https://github.com/ShubhamTiwari909/zentauri-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShubhamTiwari909/zentauri-ui.git",
    "directory": "packages/components"
  },
  "author": {
    "name": "Shubham Tiwari",
    "url": "https://www.linkedin.com/in/shubham-tiwari-b7544b193/"
  },
  "license": "MIT",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist",
    "src/ui",
    "src/animations",
    "src/design-system",
    "src/charts",
    "src/lib",
    "src/hooks",
    "cli"
  ],
  "sideEffects": false,
  "bin": {
    "zentauri-components": "cli/index.mjs",
    "zentauri-ui": "cli/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./design-system/tokens": {
      "types": "./dist/design-system/tokens.d.ts",
      "import": "./dist/design-system/tokens.mjs",
      "require": "./dist/design-system/tokens.js"
    },
    "./design-system/facade": {
      "types": "./dist/lib/facade.d.ts",
      "import": "./dist/design-system/facade.mjs",
      "require": "./dist/design-system/facade.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*/index.d.ts",
      "import": "./dist/ui/*.mjs",
      "require": "./dist/ui/*.js"
    },
    "./ui/*/animated": {
      "types": "./dist/ui/*/animated/index.d.ts",
      "import": "./dist/ui/*/animated.mjs",
      "require": "./dist/ui/*/animated.js"
    },
    "./charts/*": {
      "types": "./dist/charts/*/index.d.ts",
      "import": "./dist/charts/*.mjs",
      "require": "./dist/charts/*.js"
    },
    "./animations/*": {
      "types": "./dist/animations/*/index.d.ts",
      "import": "./dist/animations/*.mjs",
      "require": "./dist/animations/*.js"
    },
    "./hooks/utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/hooks/utils.mjs",
      "require": "./dist/hooks/utils.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*/index.d.ts",
      "import": "./dist/hooks/*.mjs",
      "require": "./dist/hooks/*.js"
    }
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup --watch",
    "build:js": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "build:types": "tsc -p tsconfig.emit-types.json",
    "build": "npm run build:js && npm run build:types",
    "generate:registry": "node scripts/generate-registry.mjs",
    "update:test-health": "node scripts/update-test-health.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "prepack": "npm run build && node scripts/generate-registry.mjs && node scripts/check-design-tokens.mjs && node scripts/check-exports.mjs",
    "test": "vitest run",
    "test:a11y": "vitest run src/accessibility/axe-core.test.tsx",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "class-variance-authority": "*",
    "clsx": "*",
    "framer-motion": "*",
    "react": ">18",
    "react-dom": ">18",
    "react-icons": "*",
    "recharts": "*",
    "tailwind-merge": "*"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    },
    "react-icons": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.0",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
