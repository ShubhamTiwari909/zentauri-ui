{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Addable UI components (src/ui), chart entries (src/charts/*), and hooks (src/hooks). Generated by scripts/generate-registry.mjs.",
  "components": [
    "accordion",
    "alert",
    "animated-number",
    "avatar",
    "badge",
    "breadcrumb",
    "buttons",
    "card",
    "charts/area",
    "charts/bar",
    "charts/bubble",
    "charts/funnel",
    "charts/line",
    "charts/pie",
    "charts/radar",
    "charts/scatter",
    "charts/stacked-bar",
    "checkbox",
    "command",
    "context-menu",
    "copy-button",
    "divider",
    "drawer",
    "dropdown",
    "dynamic-stepper",
    "empty-state",
    "file-upload",
    "inputs",
    "kbd",
    "marquee",
    "modal",
    "otp-input",
    "pagination",
    "popover",
    "progress",
    "radio-group",
    "rating",
    "scroll-area",
    "search",
    "select",
    "skeleton",
    "slider",
    "spinner",
    "stepper",
    "table",
    "tabs",
    "timeline",
    "toast",
    "toggle",
    "tooltip",
    "tree-view",
    "typography"
  ],
  "hooks": [
    "useBodyScrollLock",
    "useClickOutside",
    "useClipboard",
    "useControllableState",
    "useDebouncedValue",
    "useDisclosure",
    "useDocumentTitle",
    "useDynamicStepper",
    "useFocusManagement",
    "useHover",
    "useInView",
    "useIntersectionObserver",
    "useIsMounted",
    "useIsomorphicLayoutEffect",
    "useLocalStorage",
    "useMediaQuery",
    "useNetworkStatus",
    "usePageVisibility",
    "usePagination",
    "usePrefersColorScheme",
    "usePrefersReducedMotion",
    "useResizeObserver",
    "useSessionStorage",
    "useTableFilter",
    "useTableSort",
    "useThrottledCallback",
    "useToggle",
    "useWindowSize"
  ],
  "nameAliases": {
    "button": "buttons",
    "chart-area": "charts/area",
    "chart-bar": "charts/bar",
    "chart-bubble": "charts/bubble",
    "chart-funnel": "charts/funnel",
    "chart-line": "charts/line",
    "chart-pie": "charts/pie",
    "chart-radar": "charts/radar",
    "chart-scatter": "charts/scatter",
    "chart-stacked-bar": "charts/stacked-bar",
    "input": "inputs"
  }
}
